# Copia este archivo como .env y cambia los valores. .env nunca se sube al repositorio.
# Usa valores DISTINTOS en tu computadora y en el VPS.

# Contraseña con la que la aplicación se conecta a PostgreSQL. Nadie la escribe a mano.
# OJO: PostgreSQL solo la toma la PRIMERA vez que crea la base. Cambiarla aquí después
# no cambia la de la base (ver "Contraseñas y secretos" en el README).
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Clave con la que se firman las cookies de sesión: impide que alguien fabrique una sesión
# falsa (por ejemplo, hacerse pasar por el administrador). No es la contraseña de nadie.
# Cambiarla cierra la sesión de todos los usuarios. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-un-valor-aleatorio

# Administrador que se crea SOLO la primera vez que arranca la aplicación (base sin usuarios).
# Después se ignora: la contraseña se cambia desde la aplicación (clic en tu nombre > Mi cuenta).
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Zona horaria de la operación. Importante: define qué es "hoy" para la bitácora.
TZ=America/Caracas

# Solo producción: subdominio apuntado (registro DNS tipo A) a la IP del VPS
DOMINIO=mantenimiento.tuempresa.com

# Solo la copia piloto / demo: carga datos FICTICIOS (db/demo) la primera vez, con la base sin
# lanchas, y crea los usuarios "supervisor" y "mecanico" con esta clave (8+ caracteres).
CARGAR_DEMO=false
DEMO_PASSWORD=cambiar-clave-demo
